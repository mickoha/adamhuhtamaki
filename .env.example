# Copy to .env.local and fill in. All NEXT_PUBLIC_* values are baked into the
# static HTML at build time — they are public by definition, so only ever put
# publishable keys here (never an EmailJS private key or a reCAPTCHA secret).

# Google Analytics 4 measurement ID. Leave empty to disable analytics entirely.
NEXT_PUBLIC_GTAG_ID=

# reCAPTCHA v3 site key (google.com/recaptcha → v3, add your domain + localhost)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# EmailJS (dashboard.emailjs.com): service, template and public key.
# The contact form sends the fields: name, email, number, matter, urgency,
# matter_label, urgency_label, message.
NEXT_PUBLIC_EMAIL_SERVICE_ID=
NEXT_PUBLIC_EMAIL_TEMPLATE_ID=
NEXT_PUBLIC_EMAIL_PUBLIC_ID=
